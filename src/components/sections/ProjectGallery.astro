---
import { Image } from "astro:assets";
import { filters, projects } from "../../data/site";
import Icon from "../ui/Icon.astro";

const counts = filters.map((filter) => ({
  ...filter,
  count:
    filter.id === "todos"
      ? projects.length
      : projects.filter((project) => project.category === filter.id).length,
}));
---

<section id="proyectos" data-gallery class="relative border-t border-white/10 py-20 sm:py-28">
  <div class="container-page">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow" data-reveal>02 — Proyectos</p>
        <h2 class="section-title" data-reveal>
          Donde el rendimiento<br class="hidden sm:block" />
          se vuelve producto.
        </h2>
      </div>
      <p class="max-w-sm text-sm leading-relaxed text-zinc-500" data-reveal>
        Cuatro casos donde la arquitectura, la visualización y la operación se miden con la misma
        vara: tiempo de decisión, uptime y carga cognitiva.
      </p>
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-between gap-4" data-reveal>
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar proyectos por categoría">
        {
          counts.map((filter) => (
            <button
              type="button"
              data-filter={filter.id}
              aria-pressed={filter.id === "todos" ? "true" : "false"}
              class="filter-btn"
            >
              {filter.label}
              <span aria-hidden="true">{String(filter.count).padStart(2, "0")}</span>
            </button>
          ))
        }
      </div>
      <p
        class="font-mono text-[10px] uppercase tracking-[0.16em] text-zinc-600"
        data-gallery-status
        aria-live="polite"
      >
        {String(projects.length).padStart(2, "0")} proyectos
      </p>
    </div>

    <div class="mt-8" data-reveal>
      <div class="grid gap-5 md:grid-cols-2">
        {
          projects.map((project, index) => (
            <article
              data-project
              data-category={project.category}
              class="card spotlight group relative flex flex-col overflow-hidden transition-colors duration-300 hover:border-white/25"
            >
              <div class="relative z-10 aspect-video overflow-hidden border-b border-white/10 bg-[#0b0d10]">
                <Image
                  src={project.image}
                  alt={project.imageAlt}
                  widths={[480, 800, 1280]}
                  sizes="(min-width: 768px) 50vw, 100vw"
                  loading="lazy"
                  decoding="async"
                  class:list={[
                    "h-full w-full transition-transform duration-700 ease-out group-hover:scale-[1.03]",
                    project.imageFit === "cover" ? "object-cover" : "object-contain",
                  ]}
                />
                <div
                  class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/75 via-transparent to-ink/10"
                  aria-hidden="true"
                >
                </div>

                <span
                  class="absolute left-4 top-4 border border-white/15 bg-ink/70 px-2 py-1 font-mono text-[9px] uppercase tracking-[0.16em] text-zinc-300 backdrop-blur-sm"
                >
                  {project.categoryLabel}
                </span>
                <span
                  class="absolute right-4 top-4 font-mono text-[9px] uppercase tracking-[0.16em] text-white/70"
                >
                  {project.year}
                </span>

                <div class="absolute inset-x-4 bottom-4 flex items-end justify-between gap-4">
                  <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-acid">
                    {project.impact}
                  </p>
                  <span class="font-mono text-[9px] tracking-[0.16em] text-white/40">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                </div>
              </div>

              <div class="relative z-10 flex flex-1 flex-col p-5 sm:p-6">
                <h3 class="text-xl font-semibold tracking-tight text-white transition-colors duration-200 group-hover:text-acid">
                  {project.title}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-zinc-400">{project.description}</p>

                <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Tecnologías">
                  {project.tags.map((tag) => <li class="chip">{tag}</li>)}
                </ul>

                <div class="mt-auto pt-6">
                  {project.href ? (
                    <a
                      href={project.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-zinc-300 transition-colors hover:text-acid"
                    >
                      {project.hrefLabel ?? "Ver repositorio"}
                      <Icon name="arrow-up-right" class="h-3 w-3" />
                    </a>
                  ) : (
                    <span class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-zinc-600">
                      <Icon name="clock" class="h-3 w-3" />
                      Caso privado · detalles en entrevista
                    </span>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <div
      class="mt-8 flex flex-col gap-3 border-t border-white/10 pt-6 sm:flex-row sm:items-center sm:justify-between"
      data-reveal
    >
      <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-zinc-600">
        Arquitectura, decisiones y métricas disponibles bajo NDA
      </p>
      <a
        href="#contacto"
        class="group inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-zinc-300 transition-colors hover:text-acid"
      >
        Pedir case study
        <Icon
          name="arrow-right"
          class="h-3 w-3 transition-transform duration-200 group-hover:translate-x-1"
        />
      </a>
    </div>
  </div>
</section>
