---
import { metrics } from "../../data/site";
---

<section id="impacto" class="relative border-t border-white/10 bg-coal py-20 sm:py-28">
  <div class="container-page">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow" data-reveal>01 — Impacto medido</p>
        <h2 class="section-title max-w-2xl" data-reveal>
          Resultados auditables,<br class="hidden sm:block" />
          no promesas de pitch.
        </h2>
      </div>
      <p class="max-w-sm text-sm leading-relaxed text-zinc-500" data-reveal>
        Cuatro sistemas desplegados, cuatro reducciones medibles. Cada cifra viene de usuarios
        reales operando con el producto, no de una estimación.
      </p>
    </div>

    <div
      class="mt-12 grid gap-px border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-4"
      data-reveal
    >
      {
        metrics.map((metric, index) => (
          <div class="group relative bg-ink p-6 transition-colors duration-300 hover:bg-panel">
            <span
              class="absolute right-4 top-4 font-mono text-[9px] tracking-[0.16em] text-zinc-700"
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, "0")}
            </span>

            <div class="flex items-baseline gap-1">
              <span
                class="tabular-nums text-5xl font-semibold tracking-[-0.04em] text-white sm:text-[3.25rem]"
                data-counter
                data-value={metric.value}
              >
                0
              </span>
              <span class="text-2xl font-medium text-acid" aria-hidden="true">{metric.suffix}</span>
            </div>

            <p class="mt-4 min-h-14 text-sm leading-snug text-zinc-400">{metric.label}</p>

            <div class="mt-5 border-t border-white/10 pt-3">
              <p class="font-mono text-[9px] uppercase leading-relaxed tracking-[0.12em] text-zinc-600">
                {metric.context}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <div
      class="mt-10 flex flex-col gap-3 border-t border-white/10 pt-6 font-mono text-[10px] uppercase tracking-[0.14em] text-zinc-600 sm:flex-row sm:items-center sm:justify-between"
      data-reveal
    >
      <span class="flex items-center gap-2">
        <span class="h-1 w-1 bg-acid" aria-hidden="true"></span>
        Medido en producción · sin proyecciones
      </span>
      <span>FOVIS · AONC · Xlerion Studio · CI/CD</span>
    </div>
  </div>
</section>
