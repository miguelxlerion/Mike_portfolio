              <polygon
                points="120,203 120,185 138,194 138,212"
                fill="#091318"
                stroke="#183e49"
                stroke-width="0.6"></polygon>
            </g>

            <g>
              <polygon
                points="246.0,152.0 264.0,161.0 246.0,170.0 228.0,161.0"
                fill="#14313a"
                stroke="#27616f"
                stroke-width="0.7"></polygon>
              <polygon
                points="264,221 264,161 246,170 246,230"
