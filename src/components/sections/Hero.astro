---
import { profile, credentials } from "../../data/site";
import Icon from "../ui/Icon.astro";

const subtitle =
  "Construyo plataformas de datos en tiempo real, gemelos digitales y visualización 3D interactiva que convierten señales complejas en decisiones de negocio.";
const words = subtitle.split(" ");
---

<section
  id="inicio"
  data-hero
  class="relative overflow-hidden pb-16 pt-28 sm:pt-32 lg:pb-24 lg:pt-40"
>
  <div class="ambient-glow pointer-events-none absolute inset-0 -z-20" aria-hidden="true"></div>
  <div
    class="bg-grid mask-fade pointer-events-none absolute inset-0 -z-10 opacity-70"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-0 -z-10 mx-auto max-w-7xl border-x border-white/[0.04]"
    aria-hidden="true"
  >
  </div>

  <div class="container-page grid items-center gap-14 lg:grid-cols-[1.08fr_0.92fr] lg:gap-12">
    <div>
      <div data-hero-fade class="inline-block">
        <a
          href="#contacto"
          data-magnetic
          class="magnetic group inline-flex items-center gap-2.5 border border-white/10 bg-white/[0.03] px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.13em] text-zinc-300 transition-colors hover:border-acid/40 hover:text-white"
        >
          <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60"></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
          </span>
          <span>{profile.availability}</span>
          <Icon
            name="arrow-up-right"
            class="h-3 w-3 text-zinc-500 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
          />
        </a>
      </div>

      <h1
        class="mt-7"
        aria-label="Miguel E. Rodriguez Martinez. Senior Full-Stack Engineer | Real-Time 3D & AI Data Platforms"
      >
        <span aria-hidden="true">
          <span class="hero-line">
            <span
              data-hero-line
              class="block text-[clamp(2.75rem,7.4vw,5.6rem)] font-semibold leading-[0.92] tracking-[-0.045em] text-white"
            >
              Miguel E.
            </span>
          </span>
          <span class="hero-line">
            <span
              data-hero-line
              class="block text-[clamp(2.75rem,7.4vw,5.6rem)] font-semibold leading-[0.92] tracking-[-0.045em] text-white"
            >
              Rodriguez Martinez<span class="text-acid">.</span>
            </span>
          </span>
          <span class="hero-line mt-5">
            <span
              data-hero-line
              class="block font-mono text-[10px] uppercase tracking-[0.22em] text-zinc-500 sm:text-[11px]"
            >
              Senior Full-Stack Engineer
            </span>
          </span>
          <span class="hero-line">
            <span
              data-hero-line
              class="text-gradient block pb-1 text-[clamp(1.05rem,2.5vw,1.55rem)] font-medium tracking-tight"
            >
              Real-Time 3D &amp; AI Data Platforms
            </span>
          </span>
        </span>
      </h1>

      <p class="mt-7 max-w-xl text-base leading-relaxed text-zinc-400 sm:text-lg">
        {
          words.map((word, index) => (
            <>
              <span class="inline-block overflow-hidden pb-[0.14em] align-bottom -mb-[0.14em]">
                <span data-hero-word class="inline-block">
                  {word}
                </span>
              </span>
              {index < words.length - 1 ? " " : ""}
            </>
          ))
        }
      </p>

      <div data-hero-fade class="mt-9 flex flex-wrap items-center gap-3">
        <a href="#proyectos" class="btn btn-primary group">
          Explorar proyectos
          <Icon
            name="arrow-right"
            class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1"
          />
        </a>
        <a
          href={profile.cvEs}
          download
          class="btn btn-ghost group"
          aria-label="Descargar CV en PDF (español)"
        >
          <Icon
            name="download"
            class="h-3.5 w-3.5 text-zinc-500 transition-colors group-hover:text-white"
          />
          Descargar CV
        </a>
      </div>

      <ul
        data-hero-fade
        class="mt-10 flex flex-wrap items-center gap-x-5 gap-y-2.5 border-t border-white/10 pt-6 font-mono text-[9.5px] uppercase tracking-[0.13em] text-zinc-500 sm:text-[10px]"
      >
        <li class="flex items-center gap-2">
          <span class="h-1 w-1 bg-acid" aria-hidden="true"></span>
          Fundador · {profile.studio}
        </li>
        {credentials.map((credential) => (
          <li>{credential.label}</li>
        ))}
        <li class="text-zinc-300">+10 años</li>
      </ul>
    </div>

    <div data-hero-fade class="relative">
      <div
        data-hero-panel
        class="card relative overflow-hidden shadow-[0_40px_120px_-40px_rgba(34,211,238,0.18)]"
      >
        <div class="flex items-center justify-between border-b border-white/10 px-4 py-3">
          <div class="flex items-center gap-2">
            <Icon name="cube" class="h-3.5 w-3.5 text-acid" />
            <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-zinc-300">
              xlerion / twin-core
            </span>
          </div>
          <span class="font-mono text-[9px] uppercase tracking-[0.16em] text-zinc-600">v2.4</span>
        </div>

        <div class="relative border-b border-white/10 bg-[#070b0e]">
          <div
            class="flex items-center justify-between px-4 pt-3 font-mono text-[9px] uppercase tracking-[0.14em] text-zinc-600"
          >
            <span>FOVIS · live twin</span>
            <span class="flex items-center gap-1.5 text-emerald-400">
              <span class="h-1 w-1 animate-pulse rounded-full bg-emerald-400"></span>
              online
            </span>
          </div>

          <svg
            viewBox="0 0 420 320"
            class="mt-1 h-auto w-full"
            role="img"
            aria-label="Visualización isométrica de un gemelo digital: edificios y nodos de datos conectados sobre una retícula"
          >
            <defs>
              <radialGradient id="twin-glow" cx="50%" cy="62%" r="52%">
                <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.16"></stop>
                <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"></stop>
              </radialGradient>
              <linearGradient id="twin-scan" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#22d3ee" stop-opacity="0"></stop>
                <stop offset="50%" stop-color="#22d3ee" stop-opacity="0.75"></stop>
                <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"></stop>
              </linearGradient>
            </defs>

            <ellipse cx="210" cy="222" rx="184" ry="112" fill="url(#twin-glow)"></ellipse>
            <polygon
              points="210,140 372,221 210,302 48,221"
              fill="#080d10"
              stroke="#15242b"
              stroke-width="0.8"></polygon>

            <g stroke="#14242b" stroke-width="0.6" fill="none">
              <path d="M210,140 L48,221"></path>
              <path d="M228,149 L66,230"></path>
              <path d="M246,158 L84,239"></path>
              <path d="M264,167 L102,248"></path>
              <path d="M282,176 L120,257"></path>
              <path d="M300,185 L138,266"></path>
              <path d="M318,194 L156,275"></path>
              <path d="M336,203 L174,284"></path>
              <path d="M354,212 L192,293"></path>
              <path d="M372,221 L210,302"></path>
              <path d="M210,140 L372,221"></path>
              <path d="M192,149 L354,230"></path>
              <path d="M174,158 L336,239"></path>
              <path d="M156,167 L318,248"></path>
              <path d="M138,176 L300,257"></path>
              <path d="M120,185 L282,266"></path>
              <path d="M102,194 L264,275"></path>
              <path d="M84,203 L246,284"></path>
              <path d="M66,212 L228,293"></path>
              <path d="M48,221 L210,302"></path>
            </g>

            <path
              d="M192,194 L264,194 L246,239"
              fill="none"
              stroke="#22d3ee"
              stroke-width="0.5"
              stroke-dasharray="2 4"
              opacity="0.3"></path>

            <g fill="#22d3ee">
              <circle cx="192" cy="194" r="5" opacity="0.1"></circle>
              <circle cx="192" cy="194" r="1.8" class="animate-pulse"></circle>
              <circle cx="264" cy="194" r="5" opacity="0.1"></circle>
              <circle cx="264" cy="194" r="1.8"></circle>
              <circle cx="246" cy="239" r="5" opacity="0.1"></circle>
              <circle cx="246" cy="239" r="1.8"></circle>
              <circle cx="120" cy="230" r="5" opacity="0.1"></circle>
              <circle cx="120" cy="230" r="1.8"></circle>
              <circle cx="264" cy="248" r="1.8"></circle>
            </g>

            <g>
              <polygon
                points="210.0,132.0 228.0,141.0 210.0,150.0 192.0,141.0"
                fill="#14313a"
                stroke="#27616f"
                stroke-width="0.7"></polygon>
              <polygon
                points="228,167 228,141 210,150 210,176"
                fill="#0c1c22"
                stroke="#1d4a56"
                stroke-width="0.6"></polygon>
              <polygon
                points="192,167 192,141 210,150 210,176"
                fill="#091318"
                stroke="#183e49"
                stroke-width="0.6"></polygon>
            </g>

            <g>
              <polygon
                points="228.0,119.0 246.0,128.0 228.0,137.0 210.0,128.0"
                fill="#14313a"
                stroke="#27616f"
                stroke-width="0.7"></polygon>
              <polygon
                points="246,176 246,128 228,137 228,185"
                fill="#0c1c22"
                stroke="#1d4a56"
                stroke-width="0.6"></polygon>
              <polygon
                points="210,176 210,128 228,137 228,185"
                fill="#091318"
                stroke="#183e49"
                stroke-width="0.6"></polygon>
            </g>

            <g>
              <polygon
                points="228.0,169.0 246.0,178.0 228.0,187.0 210.0,178.0"
                fill="#14313a"
                stroke="#27616f"
                stroke-width="0.7"></polygon>
              <polygon
                points="246,194 246,178 228,187 228,203"
                fill="#0c1c22"
                stroke="#1d4a56"
                stroke-width="0.6"></polygon>
              <polygon
                points="210,194 210,178 228,187 228,203"
                fill="#091318"
                stroke="#183e49"
                stroke-width="0.6"></polygon>
            </g>

            <g>
              <polygon
                points="246.0,160.0 264.0,169.0 246.0,178.0 228.0,169.0"
                fill="#14313a"
                stroke="#27616f"
                stroke-width="0.7"></polygon>
              <polygon
                points="264,203 264,169 246,178 246,212"
                fill="#0c1c22"
                stroke="#1d4a56"
                stroke-width="0.6"></polygon>
              <polygon
                points="228,203 228,169 246,178 246,212"
                fill="#091318"
                stroke="#183e49"
                stroke-width="0.6"></polygon>
            </g>

            <g>
              <polygon
                points="174.0,154.0 192.0,163.0 174.0,172.0 156.0,163.0"
