                stroke="#1d4a56"
                stroke-width="0.6"></polygon>
              <polygon
                points="156,203 156,163 174,172 174,212"
                fill="#091318"
                stroke="#183e49"
                stroke-width="0.6"></polygon>
            </g>

            <g>
              <polygon
                points="138.0,176.0 156.0,185.0 138.0,194.0 120.0,185.0"
                fill="#14313a"
                stroke="#27616f"
                stroke-width="0.7"></polygon>
              <polygon
                points="156,203 156,185 138,194 138,212"
                fill="#0c1c22"
                stroke="#1d4a56"
