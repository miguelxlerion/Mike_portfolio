              <polygon
                points="282,230 282,206 300,215 300,239"
                fill="#091318"
                stroke="#183e49"
                stroke-width="0.6"></polygon>
            </g>

            <g>
              <polygon
                points="228.0,209.0 246.0,218.0 228.0,227.0 210.0,218.0"
                fill="#14313a"
                stroke="#27616f"
                stroke-width="0.7"></polygon>
              <polygon
                points="246,248 246,218 228,227 228,257"
                fill="#0c1c22"
                stroke="#1d4a56"
                stroke-width="0.6"></polygon>
              <polygon
                points="210,248 210,218 228,227 228,257"
                fill="#091318"
                stroke="#183e49"
                stroke-width="0.6"></polygon>
            </g>

            <g>
              <polygon
                points="192.0,187.0 210.0,196.0 192.0,205.0 174.0,196.0"
                fill="#14313a"
                stroke="#27616f"
                stroke-width="0.7"></polygon>
              <polygon
                points="210,248 210,196 192,205 192,257"
                fill="#0c1c22"
                stroke="#1d4a56"
                stroke-width="0.6"></polygon>
              <polygon
                points="174,248 174,196 192,205 192,257"
                fill="#091318"
                stroke="#183e49"
                stroke-width="0.6"></polygon>
            </g>

            <g>
              <polygon
                points="228.0,219.0 246.0,228.0 228.0,237.0 210.0,228.0"
                fill="#14313a"
                stroke="#27616f"
                stroke-width="0.7"></polygon>
              <polygon
                points="246,266 246,228 228,237 228,275"
                fill="#0c1c22"
                stroke="#1d4a56"
                stroke-width="0.6"></polygon>
              <polygon
                points="210,266 210,228 228,237 228,275"
                fill="#091318"
                stroke="#183e49"
                stroke-width="0.6"></polygon>
            </g>

            <rect
              x="0"
              y="0"
              width="420"
              height="1.5"
              fill="url(#twin-scan)"
              class="scanline"></rect>
          </svg>
        </div>

        <dl class="grid grid-cols-3 divide-x divide-white/10 border-b border-white/10">
          <div class="px-4 py-3.5">
            <dt class="font-mono text-[9px] uppercase tracking-[0.14em] text-zinc-600">
              Municipios
            </dt>
            <dd class="mt-1 font-mono text-base text-white">12+</dd>
          </div>
          <div class="px-4 py-3.5">
            <dt class="font-mono text-[9px] uppercase tracking-[0.14em] text-zinc-600">Viviendas</dt>
            <dd class="mt-1 font-mono text-base text-white">1.200+</dd>
          </div>
          <div class="px-4 py-3.5">
            <dt class="font-mono text-[9px] uppercase tracking-[0.14em] text-zinc-600">Uptime</dt>
            <dd class="mt-1 font-mono text-base text-acid">99%</dd>
          </div>
        </dl>

        <div
          class="flex items-center justify-between px-4 py-3 font-mono text-[9px] uppercase tracking-[0.14em] text-zinc-600"
        >
          <span>latencia p95 <span class="text-zinc-300">24 ms</span></span>
          <span class="flex items-center gap-1.5">
            <Icon name="clock" class="h-3 w-3" />
            sincronizado
          </span>
        </div>

        <span
          class="pointer-events-none absolute left-0 top-0 h-3 w-3 border-l border-t border-acid/50"
          aria-hidden="true"></span>
