---
interface Props {
  name:
    | "layout"
    | "server"
    | "terminal"
    | "sparkles"
    | "arrow-right"
    | "arrow-up-right"
    | "arrow-down"
    | "mail"
    | "phone"
    | "pin"
    | "github"
    | "linkedin"
