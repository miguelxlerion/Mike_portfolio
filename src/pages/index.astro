---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/sections/Hero.astro";
import ImpactMetrics from "../components/sections/ImpactMetrics.astro";
import ProjectGallery from "../components/sections/ProjectGallery.astro";
import ViewerSection from "../components/sections/ViewerSection.astro";
import LiveSites from "../components/sections/LiveSites.astro";
import Skills from "../components/sections/Skills.astro";
import Contact from "../components/sections/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Base>
  <a href="#main" data-skip-link class="skip-link">Saltar al contenido</a>

  <Navbar />

  <main id="main" tabindex="-1" class="outline-none">
    <Hero />
    <ImpactMetrics />
    <ProjectGallery />
    <ViewerSection />
    <LiveSites />
    <Skills />
    <Contact />
  </main>

  <Footer />

  <script>
    import "../lib/init";
  </script>
</Base>
