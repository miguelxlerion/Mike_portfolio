---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "lenis/dist/lenis.css";
import "../styles/global.css";
import { profile, credentials } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} — ${profile.role} | Real-Time 3D & AI Data Platforms`,
  description = "Portafolio de Miguel E. Rodriguez Martinez, Senior Full-Stack Engineer con +10 años de experiencia. Plataformas de datos en tiempo real, gemelos digitales, visualización 3D interactiva e IA aplicada. Fundador de Xlerion Studio.",
} = Astro.props;

const site = Astro.site ?? new URL("https://mike-portfolio.xlerionultimate.workers.dev");
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = new URL("/og.jpg", site).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.role,
  description,
  url: canonical,
  email: `mailto:${profile.email}`,
  telephone: profile.phoneHref,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Bogotá",
    addressCountry: "CO",
  },
  worksFor: {
    "@type": "Organization",
    name: profile.studio,
  },
  sameAs: [profile.github, profile.linkedin],
  knowsAbout: [
    "Real-time data platforms",
    "Digital twins",
    "WebGL",
    "Three.js",
    "React",
    "Python",
    "RAG",
    "LangChain",
    "pgvector",
    "Cloudflare Workers",
  ],
  hasCredential: credentials.map((credential) => ({
    "@type": "EducationalOccupationalCredential",
    name: credential.label,
    credentialCategory: "certification",
    recognizedBy: {
      "@type": "Organization",
      name: credential.issuer,
    },
  })),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="robots" content="index, follow" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Miguel E. Rodriguez Martinez — Senior Full-Stack Engineer, Real-Time 3D & AI Data Platforms" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Miguel E. Rodriguez Martinez — Senior Full-Stack Engineer, Real-Time 3D & AI Data Platforms" />

    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js-motion");
        window.setTimeout(() => {
          if (!root.classList.contains("is-motion-ready")) {
            root.classList.remove("js-motion");
          }
        }, 3000);
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen bg-ink">
    <slot />
  </body>
</html>
