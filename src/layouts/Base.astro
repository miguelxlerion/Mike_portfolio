---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "lenis/dist/lenis.css";
import "../styles/global.css";
import { getSite, type Lang } from "../data/site";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const { profile, credentials } = getSite(lang);

const defaults: Record<Lang, { title: string; description: string }> = {
  es: {
    title: `${profile.name} — ${profile.role} | Real-Time 3D & AI Data Platforms`,
    description:
      "Portafolio de Miguel E. Rodriguez Martinez, Senior Full-Stack Engineer con +10 años de experiencia. Plataformas de datos en tiempo real, gemelos digitales, visualización 3D interactiva e IA aplicada. Fundador de Xlerion Studio.",
  },
  en: {
    title: `${profile.name} — ${profile.role} | Real-Time 3D & AI Data Platforms`,
    description:
      "Portfolio of Miguel E. Rodriguez Martinez, Senior Full-Stack Engineer with 10+ years of experience. Real-time data platforms, digital twins, interactive 3D visualization and applied AI. Founder of Xlerion Studio.",
  },
};

const pageTitle = title ?? defaults[lang].title;
const pageDescription = description ?? defaults[lang].description;

const site = Astro.site ?? new URL("https://mike-portfolio.xlerionultimate.workers.dev");
const canonical = new URL(Astro.url.pathname, site).toString();
const alternateEs = new URL("/", site).toString();
const alternateEn = new URL("/en/", site).toString();
const ogImage = new URL("/og.jpg", site).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.role,
  description: pageDescription,
  url: canonical,
  inLanguage: lang,
  email: `mailto:${profile.email}`,
  telephone: profile.phoneHref,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Bogotá",
    addressCountry: "CO",
  },
  worksFor: {
    "@type": "Organization",
    name: profile.studio,
  },
  sameAs: [profile.github, profile.linkedin],
  knowsAbout: [
    "Real-time data platforms",
    "Digital twins",
    "WebGL",
    "Three.js",
    "React",
    "Python",
    "RAG",
    "LangChain",
    "pgvector",
    "Cloudflare Workers",
  ],
  hasCredential: credentials.map((credential) => ({
    "@type": "EducationalOccupationalCredential",
    name: credential.label,
    credentialCategory: "certification",
    recognizedBy: {
      "@type": "Organization",
      name: credential.issuer,
    },
  })),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={profile.name} />
    <meta name="robots" content="index, follow" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={alternateEs} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateEs} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "es" ? "es_CO" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "es" ? "en_US" : "es_CO"} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Miguel E. Rodriguez Martinez — Senior Full-Stack Engineer, Real-Time 3D & AI Data Platforms"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="twitter:image:alt"
      content="Miguel E. Rodriguez Martinez — Senior Full-Stack Engineer, Real-Time 3D & AI Data Platforms"
    />

    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js-motion");
        window.setTimeout(() => {
          if (!root.classList.contains("is-motion-ready")) {
            root.classList.remove("js-motion");
          }
        }, 3000);
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen bg-ink">
    <slot />
  </body>
</html>
